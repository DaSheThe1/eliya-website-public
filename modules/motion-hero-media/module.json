  ],
  "readiness": {
    "status": "client-implementation-required",
    "implementationPaths": [
      "app/src/components/motion/hero-media.tsx"
    ],
    "browserTestPaths": [
      "app/e2e/modules/motion-hero-media.spec.ts"
    ]
  },
  "validation": [
    "pnpm --dir app typecheck",
    "pnpm --dir app test:e2e:module e2e/modules/motion-hero-media.spec.ts"
  ]
