{
  "name": "eliya-thebeautybrand-app",
  "version": "0.7.1",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "build:static": "STATIC_EXPORT=true FOUNDATION_STATIC_COMPATIBLE=true next build",
    "start": "next start --port 3000",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:module": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "build:release": "STATIC_EXPORT=true FOUNDATION_STATIC_COMPATIBLE=true next build && node ../scripts/write-build-receipt.mjs"
  },
  "dependencies": {
    "@foundation/accessibility": "workspace:*",
    "@foundation/analytics": "workspace:*",
    "@foundation/design-tokens": "workspace:*",
    "@foundation/intake": "workspace:*",
    "@foundation/seo": "workspace:*",
    "@foundation/site-contract": "workspace:*",
    "@foundation/ui": "workspace:*",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
