# Client-safe canonical URL and optional sub-path.
NEXT_PUBLIC_SITE_URL=https://eliya.trickticmedia.com
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_DEFAULT_LOCALE=he

# Server deployment profile. Static sites are generated without server modules.
DEPLOYMENT_PROFILE=static-pages-worker

# The generator sets this to webhook for reviewed lead/booking intake and keeps
# it disabled only when intake is absent. Readiness rejects contract drift.
INTAKE_MODE=webhook
INTAKE_ALLOWED_ORIGINS=https://eliya.trickticmedia.com
INTAKE_WEBHOOK_URL=
INTAKE_WEBHOOK_SIGNING_SECRET=
INTAKE_DUPLICATE_SECRET=

# Enable only when the trusted reverse proxy overwrites forwarding headers.
INTAKE_TRUST_PROXY_HEADERS=false
