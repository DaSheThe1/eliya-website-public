{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundation.local/schemas/build-receipt.schema.json",
  "title": "Production build provenance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "version",
    "runtimeContractSha256",
    "contentManifestSha256",
    "buildInputs",
    "artifact"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "sourceState"],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sourceState": { "const": "clean" }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "runtimeContractSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contentManifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "buildInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basePath",
        "defaultLocale",
        "deploymentProfile",
        "enabledModules",
        "siteUrl"
      ],
      "properties": {
        "basePath": { "type": "string" },
        "defaultLocale": { "type": "string" },
        "deploymentProfile": {
          "enum": [
            "vps-local-build",
            "ghcr-vps-pull",
            "static-pages-worker"
          ]
        },
        "enabledModules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "siteUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "files"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
