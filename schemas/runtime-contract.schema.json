{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundation.local/schemas/runtime-contract.schema.json",
  "title": "Generated site runtime contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "foundation", "brief", "runtime"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit", "sourceState"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sourceState": {
          "enum": ["clean", "uncommitted"]
        }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generationRecordSha256",
        "defaultLocale",
        "locales",
        "enabledModules",
        "motion",
        "intakeMode",
        "intakeDestination",
        "intakeFields",
        "deploymentProfile",
        "basePath",
        "siteUrl",
        "indexable",
        "identityName",
        "testimonialState",
        "contentManifestSha256",
        "contentBinding"
      ],
      "properties": {
        "generationRecordSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "defaultLocale": {
          "type": "string",
          "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["locale", "direction", "status"],
            "properties": {
              "locale": {
                "type": "string",
                "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
              },
              "direction": { "enum": ["ltr", "rtl"] },
              "status": {
                "enum": ["confirmed", "placeholder", "deferred"]
              }
            }
          }
        },
        "enabledModules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "motion": {
          "enum": ["none", "subtle", "expressive", "experimental"]
        },
        "intakeMode": {
          "enum": ["none", "lead", "booking"]
        },
        "intakeDestination": {
          "enum": ["none", "n8n", "external-booking", "custom"]
        },
        "intakeFields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "serviceId": { "type": "boolean" },
            "name": { "type": "boolean" },
            "phone": { "type": "boolean" },
            "email": { "type": "boolean" },
            "message": { "type": "boolean" },
            "timeWindow": { "type": "boolean" }
          }
        },
        "deploymentProfile": {
          "enum": [
            "vps-local-build",
            "ghcr-vps-pull",
            "static-pages-worker"
          ]
        },
        "basePath": {
          "type": "string",
          "pattern": "^$|^/[a-zA-Z0-9/_-]*[a-zA-Z0-9_-]$"
        },
        "siteUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "indexable": { "type": "boolean" },
        "identityName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "testimonialState": {
          "enum": ["disabled", "samples", "verified"]
        },
        "contentManifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "contentBinding": {
          "enum": ["fixture", "approved"]
        }
      }
    }
  }
}
