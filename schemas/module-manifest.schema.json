{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundation.local/schemas/module-manifest.schema.json",
  "title": "Foundation module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "status",
    "summary",
    "owners",
    "requires",
    "conflicts",
    "deploymentProfiles",
    "files",
    "readiness",
    "validation"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": ["stable", "beta", "experimental", "deprecated"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["frontend", "backend", "coordinator"]
      }
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "deploymentProfiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["vps-local-build", "ghcr-vps-pull", "static-pages-worker"]
      }
    },
    "files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "implementationPaths",
        "browserTestPaths"
      ],
      "properties": {
        "status": {
          "enum": ["prebuilt", "client-implementation-required"]
        },
        "implementationPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:app/src|worker/src)/[A-Za-z0-9._/-]+$"
          }
        },
        "browserTestPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^app/e2e/[A-Za-z0-9._/-]+\\.spec\\.[cm]?[jt]sx?$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "const": "client-implementation-required" }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "implementationPaths": {
                "type": "array",
                "minItems": 1
              },
              "browserTestPaths": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "implementationPaths": {
                "type": "array",
                "maxItems": 0
              },
              "browserTestPaths": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  }
}
