{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundation.local/schemas/motion-native-scroll-story.schema.json",
  "title": "Native-scroll motion story contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "selection",
    "content",
    "geometry",
    "media",
    "eligibility",
    "interaction",
    "failOpen"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "owner", "reference"],
      "properties": {
        "approved": { "const": true },
        "owner": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stationCount",
        "serverRenderedFirstStep",
        "staticCards",
        "semanticStory"
      ],
      "properties": {
        "stationCount": { "type": "integer", "minimum": 2, "maximum": 12 },
        "serverRenderedFirstStep": { "const": true },
        "staticCards": { "const": true },
        "semanticStory": { "const": true }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stableBeforeHydration",
        "mobileViewportUnit",
        "desktopViewportUnit",
        "mobileMinimumPixels"
      ],
      "properties": {
        "stableBeforeHydration": { "const": true },
        "mobileViewportUnit": { "const": "lvh" },
        "desktopViewportUnit": { "const": "svh" },
        "mobileMinimumPixels": { "type": "integer", "minimum": 1 }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cuts", "coalescedSeeks", "posterUntilPaint", "cleanup"],
      "properties": {
        "cuts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "orientation",
              "src",
              "poster",
              "mimeType",
              "shortGopSeconds",
              "decorative"
            ],
            "properties": {
              "orientation": { "enum": ["mobile", "desktop"] },
              "src": { "type": "string", "pattern": "^/" },
              "poster": { "type": "string", "pattern": "^/" },
              "mimeType": { "const": "video/mp4" },
              "shortGopSeconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "decorative": { "const": true }
            }
          }
        },
        "coalescedSeeks": { "const": true },
        "posterUntilPaint": { "const": true },
        "cleanup": { "const": true }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siteMotionAttribute",
        "motionOnByDefault",
        "ignoreOsReducedMotion",
        "respectSaveData",
        "assignSourceAfterEligibility"
      ],
      "properties": {
        "siteMotionAttribute": { "const": "data-site-motion" },
        "motionOnByDefault": { "const": true },
        "ignoreOsReducedMotion": { "const": true },
        "respectSaveData": { "const": true },
        "assignSourceAfterEligibility": { "const": true }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nativeScroll",
        "preventDefault",
        "rootScrollSnap",
        "bodyLock",
        "settleAfterCompletedScroll",
        "maxStationsPerTouch",
        "newTouchCancelsSettle",
        "boundaryExit"
      ],
      "properties": {
        "nativeScroll": { "const": true },
        "preventDefault": { "const": false },
        "rootScrollSnap": { "const": false },
        "bodyLock": { "const": false },
        "settleAfterCompletedScroll": { "type": "boolean" },
        "maxStationsPerTouch": { "const": 1 },
        "newTouchCancelsSettle": { "const": true },
        "boundaryExit": { "const": true }
      }
    },
    "failOpen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentVisibleWithoutJavaScript",
        "contentVisibleOnMediaFailure",
        "geometryStableOnMediaFailure",
        "siteOptOutMakesZeroMediaRequests",
        "saveDataMakesZeroMediaRequests",
        "nonLooping"
      ],
      "properties": {
        "contentVisibleWithoutJavaScript": { "const": true },
        "contentVisibleOnMediaFailure": { "const": true },
        "geometryStableOnMediaFailure": { "const": true },
        "siteOptOutMakesZeroMediaRequests": { "const": true },
        "saveDataMakesZeroMediaRequests": { "const": true },
        "nonLooping": { "const": true }
      }
    }
  }
}
