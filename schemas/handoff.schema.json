{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundation.local/schemas/handoff.schema.json",
  "title": "Agent handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "status",
    "branch",
    "baseCommit",
    "commit",
    "changedFiles",
    "checks",
    "contractChanges",
    "unresolved",
    "dirtyFiles",
    "integrationNotes"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3}$"
    },
    "status": { "enum": ["complete", "partial", "blocked"] },
    "branch": { "type": "string", "minLength": 1 },
    "baseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "commit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "changedFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "notes"],
        "properties": {
          "command": { "type": "string" },
          "status": { "enum": ["passed", "failed", "skipped"] },
          "notes": { "type": "string" }
        }
      }
    },
    "contractChanges": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dirtyFiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "integrationNotes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "complete" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "dirtyFiles": { "type": "array", "maxItems": 0 }
        }
      }
    }
  ]
}
