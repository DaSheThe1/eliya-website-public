{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundation.local/schemas/review-handoff.schema.json",
  "title": "Read-only reviewer handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "status",
    "reviewedCommit",
    "checks",
    "findings",
    "unresolved",
    "integrationNotes"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3}$"
    },
    "status": { "enum": ["pass", "findings", "blocked"] },
    "reviewedCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "notes"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "skipped"] },
          "notes": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingId",
          "severity",
          "title",
          "evidence",
          "impact",
          "acceptanceCondition"
        ],
        "properties": {
          "findingId": {
            "type": "string",
            "pattern": "^F-[0-9]{3}$"
          },
          "severity": {
            "enum": ["critical", "high", "medium", "low"]
          },
          "title": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "observation"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "line": { "type": ["integer", "null"], "minimum": 1 },
                "observation": { "type": "string", "minLength": 1 }
              }
            }
          },
          "impact": { "type": "string", "minLength": 1 },
          "acceptanceCondition": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "string" }
    },
    "integrationNotes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "pass" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "findings": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "findings" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "findings": { "type": "array", "minItems": 1 }
        }
      }
    }
  ]
}
